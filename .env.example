# ==============================================================================
# Multimodal Enterprise RAG - Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Storage Paths
UPLOAD_DIRECTORY=./data/uploads
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Document Ingestion & Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
ENABLE_OCR_FALLBACK=true
OCR_MIN_TEXT_THRESHOLD=50

# Embedding Model Configuration
# Provider: "huggingface" (local) or "openai" (cloud)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# Vector Storage & Hybrid Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANKER_TOP_K=5
# Cross-encoder re-ranking model: "cross-encoder/ms-marco-MiniLM-L-6-v2" or "flashrank"
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Generation (OpenAI / Groq / Ollama Compatible)
# Provider: "openai", "groq", or "ollama"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Groq Alternative:
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Ollama Alternative (Local):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# OPENAI_API_KEY=ollama
